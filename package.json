{
  "name": "manual-studio",
  "productName": "软件指南生成器",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "vite --config web/vite.config.ts",
    "build:web": "vite build --config web/vite.config.ts",
    "start": "npm run build:web && electron .",
    "app": "electron .",
    "test": "node --test --test-concurrency=1 \"tests/*.test.mjs\"",
    "typecheck": "tsc -p web/tsconfig.json --noEmit",
    "dist": "npm run build:web && electron-builder --mac --dir"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "docx": "^9.6.1",
    "jszip": "^3.10.1"
  },
  "devDependencies": {
    "@ant-design/icons": "^6.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "antd": "^6.4.2",
    "electron": "43.4.0",
    "electron-builder": "^26.15.3",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "typescript": "^5.9.0",
    "vite": "^7.3.0"
  },
  "build": {
    "appId": "local.manual-studio",
    "productName": "软件指南生成器",
    "asar": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**",
      "core/**",
      "web/dist/**",
      "package.json"
    ],
    "mac": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "identity": null,
      "icon": "build/icon.icns"
    }
  }
}
